#!/usr/bin/env bash
# yard-quota: per-job disk quota for rootless Podman sandboxes (runs as root).
#
# Rootless Podman cannot set overlay size= quotas (it needs quotactl and
# mknod privileges it does not have). The Podman user's storage lives on an
# XFS filesystem mounted with prjquota; this helper puts a job's writable
# container layer and its volumes into one XFS project with a hard block
# limit, so writes beyond the quota fail with EDQUOT in the kernel.
#
# Callable by the gateway user through one sudoers rule. It never takes a
# path: it looks the sandbox up in Podman itself and refuses any directory
# outside the container store.
#
#   yard-quota apply <sandbox-name> <job-id> <bytes>
#   yard-quota release <job-id>
#   yard-quota check
set -euo pipefail
umask 022

STORE=/var/lib/agent-yard/containers
POD_USER=yard-pod
SOCK=unix:///run/agent-yard/podman/podman.sock
MIN_BYTES=$((512 * 1024 * 1024))
MAX_BYTES=$((10 * 1024 * 1024 * 1024 * 1024))
PROJ_BASE=100000

die() { printf '{"ok": false, "error": "%s"}\n' "$*"; exit 1; }
podman_q() { runuser -u "$POD_USER" -- podman --url "$SOCK" "$@"; }
lock() { exec 9>/run/agent-yard/quota.lock; flock 9; }

in_store() { # realpath of $1 must be strictly below $STORE
  local p; p=$(realpath -e -- "$1" 2>/dev/null) || return 1
  case "$p" in "$STORE"/*) [ ! -L "$1" ] ;; *) return 1 ;; esac
}

project_id_for() { # existing id for yard-<job>, or empty
  awk -F: -v n="yard-$1" '$1 == n {print $2}' /etc/projid
}

next_project_id() {
  local max
  max=$(awk -F: -v b="$PROJ_BASE" '$2 >= b && $2 > m {m = $2} END {print (m ? m : b)}' /etc/projid)
  echo $((max + 1))
}

cmd=${1:-}
case "$cmd" in
  check)
    findmnt -n -o FSTYPE "$STORE" 2>/dev/null | grep -qx xfs || die "$STORE is not an XFS mount"
    findmnt -n -o OPTIONS "$STORE" | grep -Eq '(^|,)(prjquota|pquota)(,|$)' || die "$STORE lacks prjquota"
    state=$(xfs_quota -x -c 'state -p' "$STORE" 2>&1 | tr '\n' ' ' | tr -d '"')
    case "$state" in *"Enforcement: ON"*) ;; *) die "project quota enforcement is off: $state" ;; esac
    printf '{"ok": true, "store": "%s", "mount": "%s"}\n' "$STORE" "$(findmnt -n -o SOURCE "$STORE")"
    ;;
  apply)
    [ $# -eq 4 ] || die "usage: apply <sandbox> <job-id> <bytes>"
    sb=$2 job=$3 bytes=$4
    [[ "$sb" =~ ^y-[a-z0-9-]{4,17}$ ]] || die "bad sandbox name"
    [[ "$job" =~ ^[a-z0-9][a-z0-9-]{2,38}[a-z0-9]$ ]] || die "bad job id"
    [[ "$bytes" =~ ^[0-9]{1,15}$ ]] || die "bad byte count"
    if [ "$bytes" -lt "$MIN_BYTES" ] || [ "$bytes" -gt "$MAX_BYTES" ]; then die "quota out of range"; fi
    lock
    cid=""
    while read -r id role; do
      [ "$role" = supervisor ] && continue
      cid=$id
    done < <(podman_q ps -a --filter "label=openshell.ai/sandbox-name=$sb" \
               --format '{{.ID}} {{index .Labels "openshell.ai/isolation-role"}}')
    [ -n "$cid" ] || die "no workload container for $sb"
    upper=$(podman_q inspect --format '{{.GraphDriver.Data.UpperDir}}' "$cid")
    mapfile -t vols < <(podman_q inspect --format '{{range .Mounts}}{{if eq .Type "volume"}}{{println .Source}}{{end}}{{end}}' "$cid" | sed '/^$/d')
    dirs=("$upper" "${vols[@]}")
    for d in "${dirs[@]}"; do in_store "$d" || die "refusing directory outside $STORE: $d"; done
    pid=$(project_id_for "$job")
    if [ -z "$pid" ]; then
      pid=$(next_project_id)
      echo "yard-$job:$pid" >>/etc/projid
    fi
    for d in "${dirs[@]}"; do
      xfs_quota -x -c "project -s -p $(realpath -e -- "$d") $pid" "$STORE" >/dev/null
    done
    xfs_quota -x -c "limit -p bhard=$bytes $pid" "$STORE"
    got=$(xfs_quota -x -c "quota -p -N -b $pid" "$STORE" | awk '{print $4}')
    if [ -z "$got" ] || [ "$got" = 0 ]; then die "limit did not take effect for project $pid"; fi
    printf '{"ok": true, "project": %s, "limit_bytes": %s, "dirs": %s}\n' "$pid" "$bytes" \
      "$(printf '%s\n' "${dirs[@]}" | jq -R . | jq -sc .)"
    ;;
  release)
    [ $# -eq 2 ] || die "usage: release <job-id>"
    job=$2
    [[ "$job" =~ ^[a-z0-9][a-z0-9-]{2,38}[a-z0-9]$ ]] || die "bad job id"
    lock
    pid=$(project_id_for "$job")
    if [ -n "$pid" ]; then
      xfs_quota -x -c "limit -p bhard=0 $pid" "$STORE" >/dev/null || true
      sed -i "/^yard-$job:$pid\$/d" /etc/projid
    fi
    printf '{"ok": true, "released": "%s"}\n' "${pid:-none}"
    ;;
  *)
    die "usage: yard-quota apply|release|check"
    ;;
esac
