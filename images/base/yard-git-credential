#!/bin/sh
# git credential helper for agent-yard sandboxes.
#
# Maps a GitHub repository path to the environment variable holding its
# OpenShell placeholder (from /sandbox/.yard/job.json): the target repo gets
# GITHUB_TOKEN, each read_repos repo its read token. The values are
# placeholders; OpenShell substitutes the real token in the outbound request
# only when the request path matches the token's binding. Anything else gets
# no credential (public clones still work).
set -eu
[ "${1:-}" = "get" ] || exit 0
JOB=/sandbox/.yard/job.json
host="" path=""
while IFS='=' read -r k v; do
  [ -z "$k" ] && break
  case "$k" in host) host=$v ;; path) path=$v ;; esac
done
[ "$host" = "github.com" ] || exit 0
[ -r "$JOB" ] || exit 0
case "$path" in *.git) ;; *) path="$path.git" ;; esac
want=$(printf '%s' "$path" | tr 'A-Z' 'a-z')
env=$(jq -r --arg p "$want" '.credentials[] | select((.path|ascii_downcase) == $p) | .env' "$JOB" | head -n1)
[ -n "$env" ] || exit 0
val=$(printenv "$env" || true)
[ -n "$val" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$val"
